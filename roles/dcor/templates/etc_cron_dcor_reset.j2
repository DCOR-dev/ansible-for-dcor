PATH=/usr/bin
# Reset the CKAN instance every Sunday for development instances.
# - `dcor-purge-all` removes users without datasets and users with datasets
#   that were inactive for more than a week (sysadmins are kept). It purges
#   all datasets, collections, and circles, except for the figshare circle
#   (`figshare-import`) and its datasets.
# - `dcor-import-figshare` only imports figshare datasets that are missing.
# - `dcor-prune-orphaned-s3-artifacts` removes the S3 objects and buckets of
#   purged datasets and circles.
{% if DCOR_DEVELOP | bool %}
30 0 * * 7 root (date && ckan dcor-purge-all --keep-circle figshare-import --user-inactive-days 7 --yes && {% if DCOR_FIGSHARE_IMPORT | bool %} ckan dcor-import-figshare && {% endif %} ckan search-index rebuild --clear && dcor inspect --assume-yes && ckan dcor-prune-orphaned-s3-artifacts) >> /var/log/ckan/ckan-cron-reset.log 2>&1
{% endif %}
